# Optional: enables the AI explanation. Without it the deterministic explanation is used.
OPENAI_API_KEY=sk-your-key-here
# Max AI explanations per UTC day (default 300)
AI_DAILY_CAP=300

# Recommended in production: shared cache, rate limits and AI budget (Upstash Redis REST).
# Without these, an in-memory fallback is used (per serverless instance, best-effort only).
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Optional: strengthens internal native-transfer evidence when public RPCs do not
# expose transaction tracing. Etherscan API V2 supports multiple EVM chains via
# the chainid parameter, including BNB Chain.
ETHERSCAN_API_KEY=your-etherscan-api-key
